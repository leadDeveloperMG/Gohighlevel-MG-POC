{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/usage",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/subscriptions",
      "schedule": "0 7 * * *"
    }
  ]
}
